---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Sermons | [CHURCH NAME]"
  description="Listen to sermons from our Reformed church on Maui, Hawaii. Expository preaching from the OPC tradition."
  canonical="https://reformedchurchmaui.com/sermons/"
  h1="Sermons"
  breadcrumb={[{ name: 'Sermons', url: 'https://reformedchurchmaui.com/sermons/' }]}
>
  <p class="text-[#5F5E5A] text-base leading-relaxed mb-10">
    Sermons will be posted here once services begin. Sign up to be notified when we launch.
  </p>

  <a href="/connect/" class="inline-block bg-[#C4A35A] text-[#1E2A3A] font-semibold px-6 py-3 rounded hover:bg-[#d4b36a] transition-colors">
    Get connected &rarr;
  </a>
</PageLayout>
